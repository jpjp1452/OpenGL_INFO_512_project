#version 400 core

layout(quads, equal_spacing, ccw) in;

in TCS_OUT {
    vec3 pos;
    vec2 texCoord;
} tes_in[];

out TES_OUT {
    vec3 pos;
    vec2 texCoord;
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;
    float height;
} tes_out;

uniform mat4 V;
uniform mat4 P;
uniform sampler2D heightMap;
uniform float HEIGHT_SCALE;

void main()
{
    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    // Bilinear interpolation
    vec3 p0 = mix(tes_in[0].pos, tes_in[1].pos, u);
    vec3 p1 = mix(tes_in[3].pos, tes_in[2].pos, u);
    vec3 pos = mix(p0, p1, v);

    vec2 tc0 = mix(tes_in[0].texCoord, tes_in[1].texCoord, u);
    vec2 tc1 = mix(tes_in[3].texCoord, tes_in[2].texCoord, u);
    vec2 texCoord = mix(tc0, tc1, v);

    // Sample height from texture
    float height = texture(heightMap, texCoord).r;
    pos.y = (height - 0.5) * HEIGHT_SCALE; // map [0,1] to [-1, 1]

    vec2 delta = 1.0 / vec2(textureSize(heightMap, 0));
    //calculate normal based on heightmap
    float heightL = texture(heightMap, texCoord - vec2(delta.x, 0.0)).r;
    float heightR = texture(heightMap, texCoord + vec2(delta.x, 0.0)).r;
    float heightD = texture(heightMap, texCoord - vec2(0.0, delta.y)).r;
    float heightU = texture(heightMap, texCoord + vec2(0.0, delta.y)).r;

    vec3 slopx = vec3(0.02*delta.x, (heightR - heightL) * HEIGHT_SCALE, 0.0);
    vec3 slopz = vec3(0.0, (heightU - heightD) * HEIGHT_SCALE, 0.02*delta.y);

    vec3 normal = normalize(cross(slopx, slopz));

    vec3 tangent = normalize(slopx);
    vec3 bitangent = normalize(slopz);

    tes_out.pos = pos;
    tes_out.texCoord = texCoord;
    tes_out.normal = normal;
    tes_out.tangent = tangent;
    tes_out.bitangent = bitangent;
    tes_out.height = height;

    gl_Position = P * V * vec4(pos, 1.0);
}
